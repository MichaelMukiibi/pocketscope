{
  "name": "pocketscope-web",
  "main": "worker.js",
  "compatibility_date": "2026-11-13",
  "previews": {},
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "services": [{ "binding": "BACKEND", "service": "pscope-api" }],
}
